{
  "name": "lib",
  "author": "Brian Jenkins",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npx tsx util/scripts/build.ts",
    "lint": "npx tsx util/scripts/lint.ts",
    "postinstall": "npx tsx util/scripts/postinstall.ts",
    "publish": "npx tsx util/scripts/publish.ts",
    "purge": "find . \\( -name \"node_modules\" -or -name \"deno.lock\" -or -name \"dist\" -or -name \"package-lock.json\" \\) -prune -exec rm -rf \"{}\" +;",
    "test": "npx tsx test/runtime/node.ts # && deno --allow-all test/runtime/deno.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "latest",
    "@eslint/js": "latest",
    "@stylistic/eslint-plugin": "latest",
    "@tsconfig/node-lts": "latest",
    "@types/node": "latest",
    "cmd-ts": "latest",
    "eslint": "latest",
    "jiti": "latest",
    "json5": "latest",
    "module-from-string": "latest",
    "react-dom": "latest",
    "semver": "latest",
    "tar-stream": "latest",
    "ts-morph": "latest",
    "ts2esm": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "zod-from-json-schema": "latest"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
